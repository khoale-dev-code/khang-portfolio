import { useEffect, useState } from 'react'

const slides = [
  {
    src: '/vexere-activation.png',
    label: 'Activation',
    title: 'Partnership activation',
    description: 'On-site partnership activation with team coordination and execution support.',
  },
  {
    src: '/vexere-booth.png',
    label: 'Brand presence',
    title: 'Booth and audience engagement',
    description: 'Event presence designed to strengthen visibility and support partner engagement.',
  },
  {
    src: '/vexere-team-studio.png',
    label: 'Collaboration',
    title: 'Team support and coordination',
    description: 'Cross-functional teamwork to keep campaign preparation and activation on track.',
  },
]

const metrics = [
  { value: '16', label: 'campaigns' },
  { value: '167%', label: 'quarterly KPI' },
  { value: '39.8K', label: 'reach' },
  { value: '503', label: 'traffic' },
]

export default function SelectedWorkVexereSlider() {
  const [active, setActive] = useState(0)
  const [paused, setPaused] = useState(false)

  useEffect(() => {
    if (paused) return undefined

    const timer = window.setInterval(() => {
      setActive((current) => (current + 1) % slides.length)
    }, 4500)

    return () => window.clearInterval(timer)
  }, [paused])

  const previous = () => {
    setActive((current) => (current === 0 ? slides.length - 1 : current - 1))
  }

  const next = () => {
    setActive((current) => (current + 1) % slides.length)
  }

  const slide = slides[active]

  return (
    <div
      className="sw-vexere-slider sw-vexere-slider-light"
      onMouseEnter={() => setPaused(true)}
      onMouseLeave={() => setPaused(false)}
      onFocus={() => setPaused(true)}
      onBlur={() => setPaused(false)}
    >
      <div className="sw-vexere-stage">

        <div className="sw-vexere-topline">
          <span className="sw-vexere-topline-left">
            VEXERE / PARTNERSHIP MARKETING
          </span>

          <span className="sw-vexere-topline-right">
            Q2 / 2026
          </span>
        </div>

        <div className="sw-vexere-layout">

          <figure className="sw-vexere-media">
            {slides.map((item, index) => (
              <div
                key={item.src}
                className={`sw-vexere-slide ${index === active ? 'is-active' : ''}`}
                aria-hidden={index !== active}
              >
                <div className="sw-vexere-media-frame">
                  <img
                    src={item.src}
                    alt={item.title}
                    className="sw-vexere-photo"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              </div>
            ))}
          </figure>

          <aside className="sw-vexere-info">
            <div className="sw-vexere-info-head">
              <span className="sw-vexere-badge">{slide.label}</span>

              <span className="sw-vexere-counter">
                {String(active + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}
              </span>
            </div>

            <div className="sw-vexere-copy">
              <h4>{slide.title}</h4>
              <p>{slide.description}</p>
            </div>

            <div className="sw-vexere-metrics">
              {metrics.map((metric) => (
                <div key={metric.label} className="sw-vexere-metric">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))}
            </div>

            <div className="sw-vexere-bottom">
              <div className="sw-vexere-dots">
                {slides.map((item, index) => (
                  <button
                    key={item.src}
                    type="button"
                    className={index === active ? 'is-active' : ''}
                    onClick={() => setActive(index)}
                    aria-label={`Show image ${index + 1}`}
                  >
                    <span />
                  </button>
                ))}
              </div>

              <div className="sw-vexere-arrows">
                <button type="button" onClick={previous} aria-label="Previous image">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="M15 18 9 12l6-6"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.8"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                    />
                  </svg>
                </button>

                <button type="button" onClick={next} aria-label="Next image">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="m9 18 6-6-6-6"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="1.8"
                      strokeLinecap="round"
                      strokeLinejoin="round"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </aside>

        </div>

        {!paused && (
          <div key={active} className="sw-vexere-progress" aria-hidden="true" />
        )}

      </div>
    </div>
  )
}