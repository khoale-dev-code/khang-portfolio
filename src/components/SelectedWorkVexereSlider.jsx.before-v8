import { useEffect, useState } from 'react'
import { AnimatePresence, motion } from 'framer-motion'

const slides = [
  {
    src: '/vexere-activation.png',
    label: 'Activation',
    title: 'Partnership activation',
    description:
      'On-site partnership activation with team coordination and execution support.',
    orientation: 'portrait',
  },
  {
    src: '/vexere-booth.png',
    label: 'Brand presence',
    title: 'Booth and audience engagement',
    description:
      'Vexere brand presence during campaign activation and partner engagement.',
    orientation: 'landscape',
  },
  {
    src: '/vexere-team-studio.png',
    label: 'Collaboration',
    title: 'Team support and coordination',
    description:
      'Team collaboration supporting partnership marketing activities.',
    orientation: 'portrait',
  },
]

const metrics = [
  {
    value: '16',
    label: 'Campaigns',
  },
  {
    value: '167%',
    label: 'Quarterly KPI',
  },
  {
    value: '39.8K',
    label: 'Reach',
  },
  {
    value: '503',
    label: 'Traffic',
  },
]

const ease = [0.22, 0.61, 0.36, 1]

export default function SelectedWorkVexereSlider() {
  const [active, setActive] = useState(0)
  const [paused, setPaused] = useState(false)

  const slide = slides[active]

  useEffect(() => {
    if (paused) return undefined

    const timer = window.setInterval(() => {
      setActive((current) => {
        return (current + 1) % slides.length
      })
    }, 4600)

    return () => {
      window.clearInterval(timer)
    }
  }, [paused])

  const previous = () => {
    setActive((current) => {
      return current === 0
        ? slides.length - 1
        : current - 1
    })
  }

  const next = () => {
    setActive((current) => {
      return (current + 1) % slides.length
    })
  }

  return (
    <motion.div
      className={`sw7-slider sw7-${slide.orientation}`}
      initial={{ opacity: 0, y: 14 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{
        once: true,
        amount: 0.2,
      }}
      transition={{
        duration: 0.6,
        ease,
      }}
      onMouseEnter={() => setPaused(true)}
      onMouseLeave={() => setPaused(false)}
      onFocus={() => setPaused(true)}
      onBlur={() => setPaused(false)}
    >
      <div className="sw7-head">

        <div>
          <span className="sw7-overline">
            VEXERE / PARTNERSHIP MARKETING
          </span>
        </div>

        <span className="sw7-date">
          Q2 / 2026
        </span>

      </div>


      <div className="sw7-main">

        <div className="sw7-media">

          <AnimatePresence mode="wait">

            <motion.figure
              key={slide.src}
              className="sw7-figure"
              initial={{
                opacity: 0,
                scale: 0.975,
              }}
              animate={{
                opacity: 1,
                scale: 1,
              }}
              exit={{
                opacity: 0,
                scale: 1.012,
              }}
              transition={{
                duration: 0.52,
                ease,
              }}
            >

              <motion.div
                className="sw7-photo-shell"
                initial={{
                  y: 8,
                }}
                animate={{
                  y: 0,
                }}
                transition={{
                  duration: 0.58,
                  ease,
                }}
              >

                <img
                  src={slide.src}
                  alt={slide.title}
                  className="sw7-photo"
                  loading="eager"
                />

              </motion.div>

            </motion.figure>

          </AnimatePresence>

        </div>


        <div className="sw7-info">

          <AnimatePresence mode="wait">

            <motion.div
              key={`info-${active}`}
              className="sw7-info-content"
              initial={{
                opacity: 0,
                x: 16,
              }}
              animate={{
                opacity: 1,
                x: 0,
              }}
              exit={{
                opacity: 0,
                x: -10,
              }}
              transition={{
                duration: 0.42,
                ease,
              }}
            >

              <div className="sw7-info-top">

                <motion.span
                  className="sw7-chip"
                  initial={{
                    opacity: 0,
                    scale: 0.92,
                  }}
                  animate={{
                    opacity: 1,
                    scale: 1,
                  }}
                  transition={{
                    delay: 0.08,
                    duration: 0.35,
                  }}
                >
                  {slide.label}
                </motion.span>

                <span className="sw7-counter">
                  {String(active + 1).padStart(2, '0')}
                  {' / '}
                  {String(slides.length).padStart(2, '0')}
                </span>

              </div>


              <div className="sw7-copy">

                <motion.h4
                  initial={{
                    opacity: 0,
                    y: 10,
                  }}
                  animate={{
                    opacity: 1,
                    y: 0,
                  }}
                  transition={{
                    delay: 0.08,
                    duration: 0.42,
                    ease,
                  }}
                >
                  {slide.title}
                </motion.h4>

                <motion.p
                  initial={{
                    opacity: 0,
                    y: 8,
                  }}
                  animate={{
                    opacity: 1,
                    y: 0,
                  }}
                  transition={{
                    delay: 0.14,
                    duration: 0.42,
                    ease,
                  }}
                >
                  {slide.description}
                </motion.p>

              </div>

            </motion.div>

          </AnimatePresence>


          <motion.div
            className="sw7-metrics"
            key={`metrics-${active}`}
            initial="hidden"
            animate="show"
            variants={{
              hidden: {},
              show: {
                transition: {
                  staggerChildren: 0.055,
                  delayChildren: 0.12,
                },
              },
            }}
          >

            {metrics.map((metric) => (
              <motion.div
                className="sw7-metric"
                key={metric.label}
                variants={{
                  hidden: {
                    opacity: 0,
                    y: 9,
                  },
                  show: {
                    opacity: 1,
                    y: 0,
                    transition: {
                      duration: 0.38,
                      ease,
                    },
                  },
                }}
                whileHover={{
                  y: -3,
                  transition: {
                    duration: 0.18,
                  },
                }}
              >

                <strong>
                  {metric.value}
                </strong>

                <span>
                  {metric.label}
                </span>

              </motion.div>
            ))}

          </motion.div>


          <div className="sw7-controls">

            <div className="sw7-dots">

              {slides.map((item, index) => (
                <button
                  type="button"
                  key={item.src}
                  className={
                    index === active
                      ? 'is-active'
                      : ''
                  }
                  onClick={() => setActive(index)}
                  aria-label={`Show image ${index + 1}`}
                >
                  <span />
                </button>
              ))}

            </div>


            <div className="sw7-arrows">

              <motion.button
                type="button"
                onClick={previous}
                aria-label="Previous image"
                whileHover={{
                  scale: 1.07,
                }}
                whileTap={{
                  scale: 0.94,
                }}
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M15 18 9 12l6-6"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="1.8"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  />
                </svg>
              </motion.button>


              <motion.button
                type="button"
                onClick={next}
                aria-label="Next image"
                whileHover={{
                  scale: 1.07,
                }}
                whileTap={{
                  scale: 0.94,
                }}
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="m9 18 6-6-6-6"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="1.8"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  />
                </svg>
              </motion.button>

            </div>

          </div>

        </div>

      </div>


      {!paused && (
        <motion.div
          key={`progress-${active}`}
          className="sw7-progress"
          initial={{
            scaleX: 0,
          }}
          animate={{
            scaleX: 1,
          }}
          transition={{
            duration: 4.6,
            ease: 'linear',
          }}
        />
      )}

    </motion.div>
  )
}